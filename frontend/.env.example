# Public - safe to expose to the browser. Never put secrets in a PUBLIC_* var.
#
# Leave PUBLIC_BACKEND_WS_URL empty (the default) and the page derives the
# backend from the address you opened it on, so the same build works on
# localhost AND from a phone at https://<lan-ip>:4321.
PUBLIC_BACKEND_WS_URL=
PUBLIC_BACKEND_PORT=8000
