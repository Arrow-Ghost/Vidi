# Copy the relevant keys into backend/.env (and frontend/.env for PUBLIC_* values).
# NEVER commit a real .env file. backend/.env and frontend/.env are gitignored.

# ---- REQUIRED ----
GEMINI_API_KEY=

# ---- BACKEND ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# ---- DATABASE (needed starting Segment 16 — Memory. Not required for Segment 1) ----
DATABASE_URL=postgresql://vidi:vidi@localhost:5432/vidi
REDIS_URL=redis://localhost:6379/0

# ---- OPTIONAL (deferred — defaults use free/local alternatives) ----
# MAPS_PROVIDER_API_KEY=
# WEATHER_PROVIDER_API_KEY=
# EXTERNAL_SPEECH_PROVIDER_API_KEY=
