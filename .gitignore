# Secrets — never commit real credentials
.env
backend/.env
frontend/.env
*.env.local

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Node / Astro
node_modules/
frontend/dist/
frontend/.astro/

# Model weights / large artifacts (downloaded, not committed)
models/weights/*
*.pt
*.onnx
*.pth

# Data that must never be committed (privacy) — camera captures, saved
# photos, anything that could be a real user/environment image.
*.jpg
*.jpeg
*.png
!docs/**/*.png
# Bundled ultralytics sample photos used as Segment 3 test fixtures — not
# user data, safe and necessary to keep tracked so `pytest` works for
# anyone who clones this repo.
!backend/tests/fixtures/*.jpg
memory_store/
recordings/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log

# Self-signed dev certificates for phone testing. The private key must
# NEVER be committed, and these are regenerated by scripts/setup_mobile.py.
certs/
*.pem

# Runtime database. Accumulates face embeddings, memories and the user
# profile as soon as the app is used - must never be committed.
backend/data/
*.db

# yolov8n.onnx IS committed (12 MB). It is what lets a deployment install ONNX
# runtimes only, instead of ~1 GB of torch + ultralytics needed solely to
# export it. Everything else in models/weights/ is fetched by
# scripts/fetch_models.py.
!models/weights/yolov8n.onnx
